// MysticQuests 2.0 tracked-quest HUD.
//
// HUD documents live in the shared Custom/Hud/ root beside the base game's own, with the mod name in
// the file name so packs cannot collide. Appended from Java as "Hud/MysticQuestsQuestHud.ui".
//
// One document holds both tracker compositions — compact and expanded — so QuestHudCoordinator can
// switch between them by patching Visible rather than removing and re-adding the HUD. A hidden
// element is skipped by its parent's layout, so whichever composition is visible sits at the edge.
//
// The puzzle card is NOT here. It sits bottom-centre, and one layout tree cannot place blocks in two
// corners: Anchor offsets are relative to where the layout puts an element, not to the screen. It is
// its own HUD layer instead — Hud/MysticQuestsPuzzleHud.ui — the way MysticRPG keeps its experience
// bar apart from its vitals.
//
// Right-side wrapper is required: Anchor.Right is only an offset from the parent's layout origin.
// Right-layout children stretch on the cross axis, so each composition carries an explicit height.

$MQ = "../mysticquests/Theme.ui";

Group {
    LayoutMode: Right;
    FlexWeight: 1;

    // ---------------------------------------------------------------- compact
    //
    // Title, one immediate objective, one progress signal. Height is the sum of the rows below plus
    // the padding (218); keep the two in step when a row changes.
    Group #CompactTracker {
        Anchor: (Top: 70, Right: 24, Width: 344, Height: 220);

        Group #TrackedQuest {
            Anchor: (Full: 0);
            LayoutMode: Top;
            Background: $MQ.@HudBackground;
            OutlineColor: $MQ.@HudBorder;
            OutlineSize: 1;
            Padding: (Left: 14, Right: 14, Top: 12, Bottom: 11);

            Group {
                Anchor: (Height: 22, Bottom: 8);
                LayoutMode: Left;

                Group {
                    Anchor: (Width: 76, Height: 22);
                    Background: $MQ.@NarrativePurple;
                    Padding: (Horizontal: 8);

                    Label #TrackedCategory {
                        Text: "QUEST";
                        Style: (...$MQ.@BadgeLabelStyle, TextColor: #FFFFFF);
                    }
                }

                Group { FlexWeight: 1; }

                Group {
                    Anchor: (Width: 72, Height: 22);
                    Background: #2A2416;
                    OutlineColor: $MQ.@QuestGold;
                    OutlineSize: 1;
                    Padding: (Horizontal: 8);

                    Label #TrackedState {
                        Text: "TRACKED";
                        Style: (...$MQ.@BadgeLabelStyle, TextColor: $MQ.@QuestGold);
                    }
                }
            }

            Label #TrackedQuestName {
                Text: "";
                Style: (FontSize: 18, RenderBold: true, TextColor: #F4F1EA, Wrap: true,
                        ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 15);
                Anchor: (Height: 28, Bottom: 1);
            }

            Label #TrackedContext {
                Text: "";
                Style: (FontSize: 10, RenderUppercase: true, LetterSpacing: 1,
                        TextColor: $MQ.@MutedText, ShrinkTextToFit: true,
                        MinShrinkTextToFitFontSize: 8);
                Anchor: (Height: 16, Bottom: 7);
            }

            Group {
                Anchor: (Height: 1, Bottom: 8);
                Background: #343D52;
            }

            Label {
                Text: "PRIMARY OBJECTIVE";
                Style: (FontSize: 10, RenderBold: true, RenderUppercase: true,
                        LetterSpacing: 1, TextColor: $MQ.@QuestGold);
                Anchor: (Height: 15, Bottom: 2);
            }

            Label #TrackedObjectiveText {
                Text: "";
                Style: (FontSize: 13, RenderBold: true, TextColor: #F4F1EA, Wrap: true,
                        ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 11);
                Anchor: (Height: 30, Bottom: 3);
            }

            Group {
                Anchor: (Height: 16, Bottom: 2);
                LayoutMode: Left;

                Label {
                    Text: "PROGRESS";
                    Style: (FontSize: 9, RenderBold: true, RenderUppercase: true,
                            TextColor: $MQ.@MutedText);
                    FlexWeight: 1;
                }

                Label #TrackedObjectiveProgress {
                    Text: "";
                    Style: (FontSize: 10, RenderBold: true, TextColor: $MQ.@GuidanceCyan,
                            HorizontalAlignment: End);
                    Anchor: (Width: 62);
                }
            }

            ProgressBar #TrackedObjectiveMeter {
                Anchor: (Height: 8, Bottom: 8);
                Background: "../mysticquests/Assets/meters/objective_frame.png";
                BarTexturePath: "../mysticquests/Assets/meters/objective_fill.png";
                Value: 0;
            }

            Group {
                Anchor: (Height: 20);
                LayoutMode: Left;

                Label #TrackedGuidance {
                    Text: "";
                    Style: (FontSize: 9, TextColor: $MQ.@MutedText, ShrinkTextToFit: true,
                            MinShrinkTextToFitFontSize: 8);
                    FlexWeight: 1;
                }

                Label #TrackedQuestProgress {
                    Text: "";
                    Style: (FontSize: 9, RenderBold: true, RenderUppercase: true,
                            TextColor: $MQ.@QuestGold, HorizontalAlignment: End);
                    Anchor: (Width: 82, Left: 8);
                }
            }
        }
    }

    // ---------------------------------------------------------------- expanded
    //
    // One primary objective plus at most three supporting rows. Rows the step does not fill are
    // hidden, and the spacer above the footer takes up the slack.
    Group #ExpandedTracker {
        Anchor: (Top: 70, Right: 24, Width: 420, Height: 410);
        LayoutMode: Top;
        Background: $MQ.@HudBackground;
        OutlineColor: $MQ.@NarrativePurple;
        OutlineSize: 1;
        Padding: (Left: 16, Right: 16, Top: 13, Bottom: 12);
        Visible: false;

        Group {
            Anchor: (Height: 22, Bottom: 8);
            LayoutMode: Left;

            Group {
                Anchor: (Width: 82, Height: 22);
                Background: $MQ.@NarrativePurple;
                Padding: (Horizontal: 8);

                Label #ExpandedCategory {
                    Text: "QUEST";
                    Style: (...$MQ.@BadgeLabelStyle, TextColor: #FFFFFF);
                }
            }

            Group { FlexWeight: 1; }

            Group {
                Anchor: (Width: 78, Height: 22);
                Background: #2A2416;
                OutlineColor: $MQ.@QuestGold;
                OutlineSize: 1;
                Padding: (Horizontal: 8);

                Label #ExpandedState {
                    Text: "TRACKED";
                    Style: (...$MQ.@BadgeLabelStyle, TextColor: $MQ.@QuestGold);
                }
            }
        }

        Label #ExpandedQuestName {
            Text: "";
            Style: (FontSize: 20, RenderBold: true, TextColor: #F4F1EA, Wrap: true,
                    ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 16);
            Anchor: (Height: 30, Bottom: 1);
        }

        Label #ExpandedContext {
            Text: "";
            Style: (FontSize: 11, RenderUppercase: true, LetterSpacing: 1,
                    TextColor: $MQ.@MutedText, ShrinkTextToFit: true,
                    MinShrinkTextToFitFontSize: 9);
            Anchor: (Height: 17, Bottom: 7);
        }

        Group {
            Anchor: (Height: 1, Bottom: 9);
            Background: #343D52;
        }

        Label {
            Text: "PRIMARY OBJECTIVE";
            Style: (FontSize: 10, RenderBold: true, RenderUppercase: true,
                    LetterSpacing: 1, TextColor: $MQ.@QuestGold);
            Anchor: (Height: 15, Bottom: 3);
        }

        Label #ExpandedPrimaryText {
            Text: "";
            Style: (FontSize: 15, RenderBold: true, TextColor: #F4F1EA, Wrap: true,
                    ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 12);
            Anchor: (Height: 34, Bottom: 3);
        }

        Group {
            Anchor: (Height: 16, Bottom: 2);
            LayoutMode: Left;

            Label #ExpandedGuidance {
                Text: "";
                Style: (FontSize: 9, TextColor: $MQ.@MutedText, ShrinkTextToFit: true,
                        MinShrinkTextToFitFontSize: 8);
                FlexWeight: 1;
            }

            Label #ExpandedPrimaryProgress {
                Text: "";
                Style: (FontSize: 10, RenderBold: true, TextColor: $MQ.@GuidanceCyan,
                        HorizontalAlignment: End);
                Anchor: (Width: 60);
            }
        }

        ProgressBar #ExpandedPrimaryMeter {
            Anchor: (Height: 8, Bottom: 10);
            Background: "../mysticquests/Assets/meters/objective_frame.png";
            BarTexturePath: "../mysticquests/Assets/meters/objective_fill.png";
            Value: 0;
        }

        Group #ExpandedRow0 {
            Anchor: (Height: 48, Bottom: 3);
            LayoutMode: Top;

            Group {
                Anchor: (Height: 24);
                LayoutMode: Left;

                Label #ExpandedRowRole0 {
                    Text: "";
                    Anchor: (Width: 80);
                    Style: (FontSize: 9, RenderBold: true, RenderUppercase: true,
                            TextColor: $MQ.@GuidanceCyan);
                }

                Label #ExpandedRowText0 {
                    Text: "";
                    FlexWeight: 1;
                    Style: (FontSize: 11, TextColor: #D8DCE5, ShrinkTextToFit: true,
                            MinShrinkTextToFitFontSize: 9);
                }

                Label #ExpandedRowProgress0 {
                    Text: "";
                    Anchor: (Width: 48);
                    Style: (FontSize: 9, TextColor: $MQ.@MutedText, HorizontalAlignment: End);
                }
            }

            ProgressBar #ExpandedRowMeter0 {
                Anchor: (Height: 5);
                Background: "../mysticquests/Assets/meters/objective_frame.png";
                BarTexturePath: "../mysticquests/Assets/meters/objective_fill.png";
                Value: 0;
            }
        }

        Group #ExpandedRow1 {
            Anchor: (Height: 48, Bottom: 3);
            LayoutMode: Top;

            Group {
                Anchor: (Height: 24);
                LayoutMode: Left;

                Label #ExpandedRowRole1 {
                    Text: "";
                    Anchor: (Width: 80);
                    Style: (FontSize: 9, RenderBold: true, RenderUppercase: true,
                            TextColor: $MQ.@GuidanceCyan);
                }

                Label #ExpandedRowText1 {
                    Text: "";
                    FlexWeight: 1;
                    Style: (FontSize: 11, TextColor: #D8DCE5, ShrinkTextToFit: true,
                            MinShrinkTextToFitFontSize: 9);
                }

                Label #ExpandedRowProgress1 {
                    Text: "";
                    Anchor: (Width: 48);
                    Style: (FontSize: 9, TextColor: $MQ.@MutedText, HorizontalAlignment: End);
                }
            }

            ProgressBar #ExpandedRowMeter1 {
                Anchor: (Height: 5);
                Background: "../mysticquests/Assets/meters/objective_frame.png";
                BarTexturePath: "../mysticquests/Assets/meters/objective_fill.png";
                Value: 0;
            }
        }

        Group #ExpandedRow2 {
            Anchor: (Height: 48, Bottom: 3);
            LayoutMode: Top;

            Group {
                Anchor: (Height: 24);
                LayoutMode: Left;

                Label #ExpandedRowRole2 {
                    Text: "";
                    Anchor: (Width: 80);
                    Style: (FontSize: 9, RenderBold: true, RenderUppercase: true,
                            TextColor: $MQ.@GuidanceCyan);
                }

                Label #ExpandedRowText2 {
                    Text: "";
                    FlexWeight: 1;
                    Style: (FontSize: 11, TextColor: #D8DCE5, ShrinkTextToFit: true,
                            MinShrinkTextToFitFontSize: 9);
                }

                Label #ExpandedRowProgress2 {
                    Text: "";
                    Anchor: (Width: 48);
                    Style: (FontSize: 9, TextColor: $MQ.@MutedText, HorizontalAlignment: End);
                }
            }

            ProgressBar #ExpandedRowMeter2 {
                Anchor: (Height: 5);
                Background: "../mysticquests/Assets/meters/objective_frame.png";
                BarTexturePath: "../mysticquests/Assets/meters/objective_fill.png";
                Value: 0;
            }
        }

        Group { FlexWeight: 1; }

        Group {
            Anchor: (Height: 1, Bottom: 8);
            Background: #343D52;
        }

        Group {
            Anchor: (Height: 24);
            LayoutMode: Left;

            Label #ExpandedActionHint {
                Text: "OPEN JOURNAL  /journal";
                Style: (FontSize: 10, RenderBold: true, RenderUppercase: true,
                        TextColor: $MQ.@GuidanceCyan);
                FlexWeight: 1;
            }

            Label #ExpandedQuestProgress {
                Text: "";
                Style: (FontSize: 10, RenderBold: true, RenderUppercase: true,
                        TextColor: $MQ.@QuestGold, HorizontalAlignment: End);
                Anchor: (Width: 92);
            }
        }
    }
}
