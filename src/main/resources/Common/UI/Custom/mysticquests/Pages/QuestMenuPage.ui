$C = "../../Common.ui";
$MQ = "../Theme.ui";

// The quest board (Redesign Bible §7.3): cards in two columns, each separating category, difficulty,
// party size and the rewards the author reveals. A locked card shows only the public requirement its
// author wrote; hidden prerequisites never reach the client. Accept is revalidated on the server.
//
// Filter chips and card rows are appended from QuestMenuPage (mysticquests/Rows/BoardFilterChip.ui,
// mysticquests/Rows/BoardCardRow.ui) and addressed positionally.

$C.@PageOverlay #BoardRoot {
  LayoutMode: Middle;

  Group #Frame {
    Anchor: (Width: 1200, Height: 660);
    LayoutMode: Top;
    Background: $MQ.@FrameBackground;
    Padding: (Full: 20);

    Group #Header {
      LayoutMode: Left;
      Anchor: (Height: 40, Bottom: 12);

      AssetImage #HeaderIcon {
        AssetPath: $MQ.@IconQuestBoard;
        Anchor: (Width: 34, Height: 34, Right: 12);
      }

      Label #ScreenTitle {
        Text: "Quest Board";
        Style: $MQ.@ScreenTitleStyle;
        FlexWeight: 1;
      }

      Label #HeaderSummary {
        Anchor: (Width: 320, Right: 14);
        Style: (FontSize: 13, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: #9AA4B7, HorizontalAlignment: End, VerticalAlignment: Center);
      }

      TextButton #CloseButton {
        Text: "Close";
        Style: $MQ.@SecondaryButtonStyle;
        Anchor: (Width: 110, Height: 36);
      }
    }

    Group #FilterBar {
      LayoutMode: Left;
      Anchor: (Height: 30, Bottom: 10);
    }

    Label #StatusText {
      Anchor: (Height: 22, Bottom: 8);
      Style: (FontSize: 14, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 11);
    }

    Group #CardRows {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@TranslucentScrollbarStyle;
    }

    Group #BoardEmpty {
      FlexWeight: 1;
      LayoutMode: Middle;
      Visible: false;

      AssetImage #EmptyIcon {
        AssetPath: $MQ.@IconQuestBoard;
        Anchor: (Width: 110, Height: 110, Bottom: 14);
      }

      Label #EmptyTitle {
        Text: "No quests available";
        Anchor: (Height: 30, Bottom: 6);
        Style: (FontSize: 22, RenderBold: true, TextColor: #F2F4F8, HorizontalAlignment: Center);
      }

      Label #EmptyBody {
        Anchor: (Width: 520);
        Style: (FontSize: 15, TextColor: #9AA4B7, Wrap: true, HorizontalAlignment: Center);
      }
    }
  }
}

$C.@BackButton {}
