$C = "../../Common.ui";
$MQ = "../Theme.ui";

// Cinematic dialogue (Redesign Bible §6.5): the world stays visible, and one band along the bottom
// carries the speaker, the line, the voice state and the choices. Choices are server-issued tokens,
// re-issued on every render, so the client can never pick a branch it was not offered.
//
// Positioning: #ConversationRoot has no LayoutMode, so its children are placed by their own Anchor
// offsets from its edges; each band then centres its fixed-width content with LayoutMode: Center.
// Choice rows are appended from ConversationPage (mysticquests/Rows/ConversationChoiceRow.ui), one
// per choice and as many as the node offers; #ChoiceList scrolls once they outgrow it.
//
// The NPC's line lives in #DialogueScroll, a fixed-height scrolling box: a long line wraps and
// scrolls inside it instead of spilling over the choices below.
//
// Character card: #SpeakerStage shows the speaking NPC's own model live, turning slowly, in the
// PrefabPreviewComponent vanilla's prefab browser uses (Pages/PrefabListPage.ui); the model arrives
// as a separate prefab preview packet (SpeakerStage / SpeakerPreviewService). When the live card is
// off or the NPC cannot be shown live, #PortraitFallback shows the model's generated portrait
// (Icons/ModelsGenerated/<model>.png, as the vanilla Memories page does), or the speaker's initials.

Group #ConversationRoot {
  Anchor: (Full: 0);
  Background: #000000(0.30);

  Group #TranscriptBand {
    Anchor: (Bottom: 452, Height: 250);
    LayoutMode: Center;

    Group #TranscriptPanel {
      Anchor: (Width: 900, Height: 250);
      LayoutMode: Top;
      Background: $MQ.@PanelBackground;
      Padding: (Full: 18);
      Visible: false;

      Label #TranscriptTitle {
        Text: "Transcript";
        Anchor: (Height: 20, Bottom: 8);
        Style: $MQ.@MicroCyanStyle;
      }

      Group #TranscriptScroll {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@TranslucentScrollbarStyle;

        Label #TranscriptText {
          Style: (FontSize: 14, TextColor: #C9CFDA, Wrap: true);
        }
      }
    }
  }

  Group #DialogueBand {
    Anchor: (Bottom: 36, Height: 400);
    LayoutMode: Center;

    Group #DialogueRow {
      Anchor: (Width: 1160, Height: 400);
      LayoutMode: Left;

      Group #SpeakerPortrait {
        Anchor: (Width: 200, Right: 20);
        LayoutMode: Top;
        Background: $MQ.@SelectedCardBackground;
        Padding: (Full: 16);

        Group #PortraitFrame {
          FlexWeight: 1;
          Background: $MQ.@InsetBackground;
          Anchor: (Bottom: 12);

          Group #PortraitFallback {
            Anchor: (Full: 0);
            LayoutMode: Middle;

            AssetImage #SpeakerImage {
              Anchor: (Width: 160, Height: 160);
              FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
              Visible: false;
            }

            Label #SpeakerInitials {
              Anchor: (Height: 60);
              Style: (FontSize: 40, RenderBold: true, TextColor: #B9A2F2, HorizontalAlignment: Center, VerticalAlignment: Center);
            }
          }

          Group #SpeakerStageWrap {
            Anchor: (Full: 4);
            LayoutMode: Full;
            Visible: false;

            PrefabPreviewComponent #SpeakerStage {
              Anchor: (Full: 0);
              AllowDragYaw: true;
              AllowDragPitch: true;
              AllowZoom: true;
              AllowPan: false;
              ShowAnchor: false;
            }
          }
        }

        Label #SpeakerName {
          Anchor: (Height: 24);
          Style: (FontSize: 15, RenderBold: true, RenderUppercase: true, TextColor: #CCAA58, HorizontalAlignment: Center, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 10);
        }
      }

      Group #DialoguePanel {
        FlexWeight: 1;
        LayoutMode: Top;
        Background: $MQ.@SelectedCardBackground;
        Padding: (Horizontal: 24, Top: 18, Bottom: 14);

        Group #SpeakerRow {
          LayoutMode: Left;
          Anchor: (Height: 28, Bottom: 10);

          TextButton #VoiceBadge {
            Text: "Voice";
            Anchor: (Width: 84, Height: 26, Right: 12);
            Style: $MQ.@BadgePurple;
          }

          Label #SpeakerTitle {
            FlexWeight: 1;
            Style: (FontSize: 20, RenderBold: true, TextColor: #F2F4F8, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 13);
          }
        }

        Group #DialogueScroll {
          Anchor: (Height: 104, Bottom: 8);
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;

          Label #DialogueText {
            Style: (FontSize: 18, RenderBold: true, TextColor: #F2F4F8, Wrap: true);
          }
        }

        Group #ChoiceDivider {
          Anchor: (Height: 1, Bottom: 8);
          Background: #F2F4F8(0.15);
        }

        Group #ChoiceList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }

        Group #Footer {
          LayoutMode: Left;
          Anchor: (Height: 30, Top: 6);

          Label #FooterHint {
            FlexWeight: 1;
            Style: (FontSize: 13, TextColor: #9AA4B7, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 10);
          }

          TextButton #TranscriptToggle {
            Text: "Transcript";
            Anchor: (Width: 130, Height: 30, Right: 8);
            Style: $MQ.@SecondaryButtonStyle;
          }

          TextButton #LeaveButton {
            Text: "Leave";
            Anchor: (Width: 110, Height: 30);
            Style: $MQ.@SecondaryButtonStyle;
          }
        }
      }
    }
  }
}
