$C = "../../Common.ui";
$MQ = "../Theme.ui";

// The Quest Journal (Redesign Bible §7.1-7.2, §7.4).
//
// Three panels, as the concept screen draws them: a rail of sections (tracked, quests by category,
// stories, completed, abandoned), the quests in the selected section, and the selected quest's
// detail. Quest settings replace the list and the detail when chosen from the rail.
//
// Rows are appended from MysticQuestJournalPage as their own documents (mysticquests/Rows/...) and
// addressed positionally, #RailList[i] #Name, the way the engine's own pages fill lists.
//
// Sized for a 1280x720 screen: 1200 x 660 with the frame's padding inside it.

$C.@PageOverlay #JournalRoot {
  LayoutMode: Middle;

  Group #Frame {
    Anchor: (Width: 1200, Height: 660);
    LayoutMode: Top;
    Background: $MQ.@FrameBackground;
    Padding: (Full: 20);

    Group #Header {
      LayoutMode: Left;
      Anchor: (Height: 40, Bottom: 14);

      AssetImage #HeaderIcon {
        AssetPath: $MQ.@IconJournal;
        Anchor: (Width: 34, Height: 34, Right: 12);
      }

      Label #ScreenTitle {
        Text: "Quest Journal";
        Style: $MQ.@ScreenTitleStyle;
        FlexWeight: 1;
      }

      Label #HeaderSummary {
        Anchor: (Width: 460, Right: 14);
        Style: (FontSize: 13, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: #9AA4B7, HorizontalAlignment: End, VerticalAlignment: Center);
      }

      TextButton #CloseButton {
        Text: "Close";
        Style: $MQ.@SecondaryButtonStyle;
        Anchor: (Width: 110, Height: 36);
      }
    }

    Group #Body {
      FlexWeight: 1;
      LayoutMode: Left;

      // ------------------------------------------------------------ rail

      Group #Rail {
        Anchor: (Width: 214, Right: 14);
        LayoutMode: Top;
        Background: $MQ.@PanelBackground;
        Padding: (Full: 12);

        Group #RailList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@TranslucentScrollbarStyle;
        }

        Group #RailRule {
          Anchor: (Height: 1, Top: 8, Bottom: 8);
          Background: $MQ.@RuleBackground;
        }

        TextButton #SettingsButton {
          Text: "Quest settings";
          Style: $MQ.@NavStyle;
          Anchor: (Height: 38);
          Padding: (Horizontal: 14);
        }
      }

      // ------------------------------------------------------------ quest list

      Group #ListPanel {
        Anchor: (Width: 330, Right: 14);
        LayoutMode: Top;
        Background: $MQ.@PanelBackground;
        Padding: (Full: 14);

        Label #ListTitle {
          Anchor: (Height: 20, Bottom: 10);
          Style: $MQ.@MicroGoldStyle;
        }

        Group #QuestList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@TranslucentScrollbarStyle;
        }
      }

      // ------------------------------------------------------------ detail

      Group #DetailPanel {
        FlexWeight: 1;
        LayoutMode: Top;
        Background: $MQ.@PanelBackground;
        Padding: (Full: 22);

        Group #EmptyState {
          FlexWeight: 1;
          LayoutMode: Middle;
          Visible: false;

          AssetImage #EmptyIcon {
            AssetPath: $MQ.@MissingIcon;
            Anchor: (Width: 96, Height: 96, Bottom: 14);
          }

          Label #EmptyTitle {
            Anchor: (Height: 30, Bottom: 6);
            Style: (FontSize: 20, RenderBold: true, TextColor: #F2F4F8, HorizontalAlignment: Center);
          }

          Label #EmptyBody {
            Anchor: (Width: 420);
            Style: (FontSize: 15, TextColor: #9AA4B7, Wrap: true, HorizontalAlignment: Center);
          }
        }

        Group #QuestDetails {
          FlexWeight: 1;
          LayoutMode: Top;

          Group #BadgeRow {
            LayoutMode: Left;
            Anchor: (Height: 26, Bottom: 12);

            TextButton #DetailCategory {
              Style: $MQ.@BadgePurple;
              Anchor: (Width: 110, Height: 26, Right: 8);
            }

            TextButton #DetailState {
              Style: $MQ.@BadgeGoldOutline;
              Anchor: (Width: 110, Height: 26);
            }

            Group #BadgeSpacer {
              FlexWeight: 1;
            }

            Label #DetailWhen {
              Anchor: (Width: 220);
              Style: (FontSize: 13, TextColor: #9AA4B7, HorizontalAlignment: End, VerticalAlignment: Center);
            }
          }

          Label #DetailTitle {
            Anchor: (Height: 34);
            Style: $MQ.@QuestTitleStyle;
          }

          Label #DetailContext {
            Anchor: (Height: 22, Bottom: 12);
            Style: $MQ.@MetaStyle;
          }

          Group #DetailScroll {
            FlexWeight: 1;
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@TranslucentScrollbarStyle;

            Group #ObjectiveBlock {
              LayoutMode: Top;
              Anchor: (Bottom: 18);

              Label #ObjectiveCaption {
                Text: "Current objective";
                Anchor: (Height: 20, Bottom: 4);
                Style: $MQ.@MicroGoldStyle;
              }

              Label #ObjectiveText {
                Anchor: (Height: 28, Bottom: 6);
                Style: $MQ.@ObjectiveStyle;
              }

              Group #ObjectiveMeterRow {
                LayoutMode: Left;
                Anchor: (Height: 18);

                ProgressBar #ObjectiveMeter {
                  Anchor: (Width: 360, Height: 8, Top: 5);
                  Background: "../Assets/v2/MeterTrack.png";
                  BarTexturePath: "../Assets/v2/MeterGold.png";
                  Value: 0;
                }

                Label #ObjectiveProgress {
                  Anchor: (Width: 90, Left: 12);
                  Style: (FontSize: 14, RenderBold: true, TextColor: #9AA4B7, VerticalAlignment: Center);
                }
              }
            }

            Group #RecapBlock {
              LayoutMode: Top;
              Anchor: (Bottom: 18);

              Label #RecapCaption {
                Text: "Story recap";
                Anchor: (Height: 20, Bottom: 4);
                Style: $MQ.@MicroCyanStyle;
              }

              Label #RecapText {
                Style: $MQ.@BodyStyle;
              }
            }

            Group #ObjectivesBlock {
              LayoutMode: Top;
              Anchor: (Bottom: 18);

              Group #ObjectivesHeader {
                LayoutMode: Left;
                Anchor: (Height: 20, Bottom: 6);

                Label #ObjectivesCaption {
                  FlexWeight: 1;
                  Style: $MQ.@MicroMutedStyle;
                }

                Label #ObjectivesSummary {
                  Anchor: (Width: 160);
                  Style: (FontSize: 13, RenderBold: true, TextColor: #46C6C4, HorizontalAlignment: End);
                }
              }

              Group #ObjectiveList {
                LayoutMode: Top;
              }
            }

            Group #RewardsBlock {
              LayoutMode: Top;
              Anchor: (Bottom: 18);

              Label #RewardsCaption {
                Text: "Rewards";
                Anchor: (Height: 20, Bottom: 4);
                Style: $MQ.@MicroGoldStyle;
              }

              Label #RewardsText {
                Style: (FontSize: 15, TextColor: #F2F4F8, Wrap: true);
              }
            }

            Group #TimelineBlock {
              LayoutMode: Top;

              Label #TimelineCaption {
                Text: "Timeline";
                Anchor: (Height: 20, Bottom: 4);
                Style: $MQ.@MicroMutedStyle;
              }

              Group #TimelineList {
                LayoutMode: Top;
              }
            }
          }

          Group #Actions {
            LayoutMode: Left;
            Anchor: (Height: 40, Top: 14);

            TextButton #TrackButton {
              Text: "Track quest";
              Style: $MQ.@PrimaryButtonStyle;
              Anchor: (Width: 170, Height: 40, Right: 10);
            }

            TextButton #AbandonButton {
              Text: "Abandon";
              Style: $MQ.@DangerButtonStyle;
              Anchor: (Width: 170, Height: 40, Right: 10);
            }

            Label #ActionNote {
              FlexWeight: 1;
              Style: (FontSize: 13, TextColor: #9AA4B7, VerticalAlignment: Center, Wrap: true);
            }
          }
        }
      }

      // ------------------------------------------------------------ settings (§7.4)

      Group #SettingsPanel {
        FlexWeight: 1;
        LayoutMode: Top;
        Visible: false;

        Group #SettingsTop {
          LayoutMode: Left;
          Anchor: (Height: 160, Bottom: 14);

          Group #DensityCard {
            FlexWeight: 1;
            LayoutMode: Top;
            Background: $MQ.@PanelBackground;
            Padding: (Full: 16);
            Anchor: (Right: 14);

            Label #DensityTitle {
              Text: "Quest tracker";
              Anchor: (Height: 22, Bottom: 2);
              Style: (FontSize: 17, RenderBold: true, TextColor: #CCAA58);
            }

            Label #DensityHint {
              Text: "How much of your tracked quest stays on screen.";
              Anchor: (Height: 20, Bottom: 10);
              Style: (FontSize: 13, TextColor: #9AA4B7);
            }

            Group #DensityRowOne {
              LayoutMode: Left;
              Anchor: (Height: 36, Bottom: 8);

              TextButton #DensityAuto {
                Text: "Automatic";
                Style: $MQ.@SecondaryButtonStyle;
                FlexWeight: 1;
                Anchor: (Right: 8);
              }

              TextButton #DensityExpanded {
                Text: "Expanded";
                Style: $MQ.@SecondaryButtonStyle;
                FlexWeight: 1;
              }
            }

            Group #DensityRowTwo {
              LayoutMode: Left;
              Anchor: (Height: 36);

              TextButton #DensityCompact {
                Text: "Compact";
                Style: $MQ.@SecondaryButtonStyle;
                FlexWeight: 1;
                Anchor: (Right: 8);
              }

              TextButton #DensityHidden {
                Text: "Hidden";
                Style: $MQ.@SecondaryButtonStyle;
                FlexWeight: 1;
              }
            }
          }

          Group #AudioCard {
            FlexWeight: 1;
            LayoutMode: Top;
            Background: $MQ.@PanelBackground;
            Padding: (Full: 16);

            Label #AudioTitle {
              Text: "Story audio";
              Anchor: (Height: 22, Bottom: 2);
              Style: (FontSize: 17, RenderBold: true, TextColor: #CCAA58);
            }

            Label #AudioHint {
              Text: "Subtitles show for voiced lines even with sound off.";
              Anchor: (Height: 20, Bottom: 10);
              Style: (FontSize: 13, TextColor: #9AA4B7);
            }

            Group #SubtitleRow {
              LayoutMode: Left;
              Anchor: (Height: 36, Bottom: 8);

              Label #SubtitleLabel {
                Text: "Subtitles";
                FlexWeight: 1;
                Style: (FontSize: 15, RenderBold: true, TextColor: #F2F4F8, VerticalAlignment: Center);
              }

              TextButton #SubtitlesOn {
                Text: "On";
                Style: $MQ.@SecondaryButtonStyle;
                Anchor: (Width: 96, Right: 8);
              }

              TextButton #SubtitlesOff {
                Text: "Off";
                Style: $MQ.@SecondaryButtonStyle;
                Anchor: (Width: 96);
              }
            }

            Group #VoiceRow {
              LayoutMode: Left;
              Anchor: (Height: 36);

              Label #VoiceLabel {
                FlexWeight: 1;
                Style: (FontSize: 14, TextColor: #C9CFDA, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 11);
              }

              TextButton #VoiceAuto {
                Text: "Game language";
                Style: $MQ.@SecondaryButtonStyle;
                Anchor: (Width: 200);
              }
            }
          }
        }

        Group #SettingsBottom {
          LayoutMode: Left;
          FlexWeight: 1;

          Group #MotionCard {
            FlexWeight: 1;
            LayoutMode: Top;
            Background: $MQ.@PanelBackground;
            Padding: (Full: 16);
            Anchor: (Right: 14);

            Label #MotionTitle {
              Text: "Motion";
              Anchor: (Height: 22, Bottom: 2);
              Style: (FontSize: 17, RenderBold: true, TextColor: #CCAA58);
            }

            Label #MotionHint {
              Anchor: (Height: 40, Bottom: 10);
              Style: (FontSize: 13, TextColor: #9AA4B7, Wrap: true);
            }

            Group #PopupRow {
              LayoutMode: Left;
              Anchor: (Height: 36);

              Label #PopupLabel {
                Text: "Quest pop-ups";
                FlexWeight: 1;
                Style: (FontSize: 15, RenderBold: true, TextColor: #F2F4F8, VerticalAlignment: Center);
              }

              TextButton #PopupsOn {
                Text: "On";
                Style: $MQ.@SecondaryButtonStyle;
                Anchor: (Width: 96, Right: 8);
              }

              TextButton #PopupsOff {
                Text: "Off";
                Style: $MQ.@SecondaryButtonStyle;
                Anchor: (Width: 96);
              }
            }
          }

          Group #AboutCard {
            FlexWeight: 1;
            LayoutMode: Top;
            Background: $MQ.@PanelBackground;
            Padding: (Full: 16);

            Label #AboutTitle {
              Text: "Your preferences";
              Anchor: (Height: 22, Bottom: 2);
              Style: (FontSize: 17, RenderBold: true, TextColor: #CCAA58);
            }

            Label #AboutText {
              Text: "Saved for you on this server, so they follow you between sessions. /mquest hud and /mquest audio change the same settings.";
              FlexWeight: 1;
              Style: (FontSize: 13, TextColor: #9AA4B7, Wrap: true);
            }

            Group #AboutActions {
              LayoutMode: Left;
              Anchor: (Height: 36);

              Group #AboutSpacer {
                FlexWeight: 1;
              }

              TextButton #RestoreDefaults {
                Text: "Restore defaults";
                Style: $MQ.@SecondaryButtonStyle;
                Anchor: (Width: 190);
              }
            }
          }
        }
      }
    }
  }
}

$C.@BackButton {}
