$Base = "../../Common.ui";
$MQ = "../Theme.ui";

// The Quest Journal (Redesign Bible §7.1-7.2, §7.4): the authoritative quest detail. A left rail
// groups tracked, story, side and finished quests and the player's 2.0 stories; the detail pane
// shows the current objective, the story so far, objectives by step, revealed rewards and a short
// timeline. Settings share the detail pane. Rows are appended from MysticQuestJournalPage.

$Base.@PageOverlay {}

$Base.@Container {
  Anchor: (Width: 1120, Height: 680);

  #Title {
    $MQ.@HeaderBar {
      AssetImage {
        AssetPath: $MQ.@IconJournal;
        Anchor: (Width: 40, Height: 40, Right: 10);
      }

      Group {
        LayoutMode: Top;
        Anchor: (Width: 280, Height: 44);

        Label {
          Text: "MYSTICQUESTS";
          Style: (...$MQ.@PageTitleStyle, FontSize: 21);
        }

        Label {
          Text: "QUEST JOURNAL";
          Style: (...$MQ.@SmallBoldStyle, FontSize: 10, TextColor: $MQ.@MutedText);
        }
      }

      Group { FlexWeight: 1; }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 30);

        Group {
          LayoutMode: Left;
          Background: $MQ.@GoldBg;
          Padding: (Horizontal: 12, Vertical: 5);
          Anchor: (Right: 4);

          Label { Text: "ACTIVE"; Style: (...$MQ.@SmallBoldStyle, TextColor: $MQ.@QuestGold); Anchor: (Right: 7); }
          Label #ActiveCount { Text: "0"; Style: (...$MQ.@SmallBoldStyle, TextColor: $MQ.@QuestGold); }
        }

        Group {
          LayoutMode: Left;
          Background: $MQ.@PurpleBg;
          Padding: (Horizontal: 12, Vertical: 5);
          Anchor: (Right: 4);

          Label { Text: "STORIES"; Style: (...$MQ.@SmallBoldStyle, TextColor: $MQ.@AccentPurple); Anchor: (Right: 7); }
          Label #StoryCount { Text: "0"; Style: (...$MQ.@SmallBoldStyle, TextColor: $MQ.@AccentPurple); }
        }

        Group {
          LayoutMode: Left;
          Background: $MQ.@PanelRaised;
          Padding: (Horizontal: 12, Vertical: 5);

          Label { Text: "COMPLETE"; Style: (...$MQ.@SmallBoldStyle, TextColor: $MQ.@TextSecondary); Anchor: (Right: 7); }
          Label #CompletedCount { Text: "0"; Style: (...$MQ.@SmallBoldStyle, TextColor: $MQ.@TextMuted); }
        }
      }
    }
  }

  #Content {
    LayoutMode: Left;
    Background: $MQ.@DarkPanelBackground;
    Padding: (Left: 14, Right: 14, Top: 12, Bottom: 14);

    Group {
      Anchor: (Width: 290, Right: 12);
      LayoutMode: Top;
      Background: #0A0D13(0.90);

      // Section headers and rows, appended in order: tracked, by category, stories, finished.
      Group #RailList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $Base.@DefaultScrollbarStyle;
        Padding: (Horizontal: 6, Top: 6, Bottom: 6);
      }

      Group { Anchor: (Height: 1, Bottom: 6); Background: $MQ.@BorderSoft; }

      Group #RailFooter {
        LayoutMode: Top;
        Padding: (Horizontal: 6, Bottom: 6);
      }
    }

    Group {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Left: 22, Right: 22, Top: 18, Bottom: 18);
      Background: #161B26(0.92);

      Group #EmptyState {
        FlexWeight: 1;
        LayoutMode: Center;
        Visible: false;

        Group {
          Anchor: (Width: 430, Height: 260);
          LayoutMode: Top;

          AssetImage { AssetPath: $MQ.@MissingIcon; Anchor: (Width: 112, Height: 112, Bottom: 12); }
          Label #EmptyStateTitle { Text: ""; Style: (...$MQ.@QuestTitleStyle, FontSize: 22, TextColor: $MQ.@GuidanceCyan, HorizontalAlignment: Center); Anchor: (Bottom: 8); }
          Label #EmptyStateBody { Text: ""; Style: (...$MQ.@BodyTextStyle, TextColor: $MQ.@MutedText, HorizontalAlignment: Center); }
        }
      }

      Group #QuestDetails {
        FlexWeight: 1;
        LayoutMode: Top;

        Group {
          Anchor: (Height: 22, Bottom: 8);
          LayoutMode: Left;

          Group {
            Anchor: (Width: 96, Height: 22, Right: 6);
            Background: $MQ.@NarrativePurple;
            Padding: (Horizontal: 8);

            Label #DetailCategory {
              Text: "QUEST";
              Style: (...$MQ.@BadgeLabelStyle, TextColor: #FFFFFF);
            }
          }

          Group {
            Anchor: (Width: 96, Height: 22);
            Background: #2A2416;
            OutlineColor: $MQ.@QuestGold;
            OutlineSize: 1;
            Padding: (Horizontal: 8);

            Label #DetailState {
              Text: "ACTIVE";
              Style: (...$MQ.@BadgeLabelStyle, TextColor: $MQ.@QuestGold);
            }
          }

          Group { FlexWeight: 1; }

          Label #DetailWhen { Text: ""; Style: (...$MQ.@SmallBoldStyle, FontSize: 10, TextColor: $MQ.@MutedText); }
        }

        Label #SelectedQuestName { Text: ""; Style: (...$MQ.@QuestTitleStyle, FontSize: 26, TextColor: $MQ.@TextPrimary); Anchor: (Bottom: 2); }
        Label #SelectedStep { Text: ""; Style: (...$MQ.@SmallBoldStyle, FontSize: 12, TextColor: $MQ.@GuidanceCyan); Anchor: (Bottom: 10); }

        Group #CurrentObjectiveCard {
          Anchor: (Height: 58, Bottom: 10);
          LayoutMode: Left;
          Background: #0A0D13(0.75);
          Padding: (Right: 14);

          Group { Anchor: (Width: 4, Right: 12); Background: $MQ.@QuestGold; }

          Group {
            FlexWeight: 1;
            LayoutMode: Top;
            Padding: (Top: 8);

            Label { Text: "CURRENT OBJECTIVE"; Style: (...$MQ.@SmallBoldStyle, FontSize: 10, TextColor: $MQ.@QuestGold); Anchor: (Bottom: 3); }
            Label #CurrentObjectiveText { Text: ""; Style: (FontSize: 17, RenderBold: true, TextColor: $MQ.@TextPrimary, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 12); }
          }

          Label #CurrentObjectiveProgress { Text: ""; Style: (FontSize: 15, RenderBold: true, TextColor: $MQ.@QuestGold, VerticalAlignment: Center); Anchor: (Width: 80); }
        }

        Label #SelectedQuestDescription { Text: ""; Style: (...$MQ.@BodyTextStyle, FontSize: 15); Anchor: (Bottom: 12); }
        Group { Anchor: (Height: 1, Bottom: 10); Background: $MQ.@BorderSoft; }

        Group {
          Anchor: (Height: 26, Bottom: 6);
          LayoutMode: Left;
          Label #ObjectiveHeading { Text: "OBJECTIVES"; Style: (...$MQ.@SectionTitleStyle, FontSize: 13); }
          Group { FlexWeight: 1; }
          Label #ObjectiveSummary { Text: ""; Style: (...$MQ.@ProgressStyle, FontSize: 12); }
        }

        // Quests run to a dozen objectives and more, so the list scrolls inside the panel rather
        // than running past the rewards, timeline and buttons below it.
        Group #ObjectiveList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $Base.@DefaultScrollbarStyle;
          Padding: (Right: 4, Bottom: 4);
        }

        Group #RewardsRow {
          Anchor: (Height: 30, Top: 8);
          LayoutMode: Left;

          AssetImage { AssetPath: $MQ.@IconReward; Anchor: (Width: 22, Height: 22, Right: 8); }
          Label { Text: "REWARDS"; Style: (...$MQ.@SmallBoldStyle, FontSize: 10, TextColor: $MQ.@QuestGold, VerticalAlignment: Center); Anchor: (Width: 70); }
          Label #RewardsText { Text: ""; Style: (FontSize: 13, TextColor: $MQ.@TextSecondary, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 10); FlexWeight: 1; }
        }

        Group #TimelineSection {
          LayoutMode: Top;
          Anchor: (Top: 8);

          Label { Text: "TIMELINE"; Style: (...$MQ.@SmallBoldStyle, FontSize: 10, TextColor: $MQ.@MutedText); Anchor: (Bottom: 4); }
          Group #TimelineList { LayoutMode: Top; }
        }

        Group #QuestActions {
          LayoutMode: Left;
          Anchor: (Height: 38, Top: 12);

          TextButton #TrackButton { Text: "TRACK QUEST"; Style: $MQ.@PrimaryButtonStyle; Anchor: (Width: 176, Height: 38, Right: 8); }
          TextButton #AbandonButton { Text: "ABANDON"; Style: $MQ.@DestructiveButtonStyle; Anchor: (Width: 176, Height: 38); }
        }
      }

      Group #SettingsPanel {
        FlexWeight: 1;
        LayoutMode: Top;
        Visible: false;

        Label { Text: "QUEST SETTINGS"; Style: (...$MQ.@QuestTitleStyle, FontSize: 24, TextColor: $MQ.@TextPrimary); Anchor: (Bottom: 4); }
        Label { Text: "How quests show on your screen. Saved for you on this server."; Style: (...$MQ.@BodyTextStyle, TextColor: $MQ.@MutedText); Anchor: (Bottom: 14); }

        Group #SettingsList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $Base.@DefaultScrollbarStyle;
          Padding: (Right: 4);
        }
      }
    }
  }
}

$Base.@BackButton {}
