$Base = "../../Common.ui";
$MQ = "../Theme.ui";

$Base.@PageOverlay {
  Background: #000000(0.80);
}

Group {
  LayoutMode: Center;
  Anchor: (Full: 0);

  Group {
    Anchor: (Width: 700, Height: 500);
    LayoutMode: Top;
    Background: $MQ.@DarkPanelBackground;
    Padding: (Horizontal: 70, Top: 40, Bottom: 46);

    AssetImage {
      AssetPath: $MQ.@IconComplete;
      Anchor: (Width: 132, Height: 132, Bottom: 6);
    }

    Group {
      LayoutMode: Center;
      Anchor: (Bottom: 8);

      Label {
        Text: "QUEST COMPLETE";
        Style: (...$MQ.@PageTitleStyle, FontSize: 34, TextColor: $MQ.@AccentGold);
      }
    }

    Label #CompletedQuestName {
      Text: "Quest Name";
      Style: (...$MQ.@QuestTitleStyle, HorizontalAlignment: Center);
      Anchor: (Bottom: 22);
    }

    Group {
      Anchor: (Height: 1, Bottom: 22);
      Background: $MQ.@BorderGold;
    }

    Label {
      Text: "REWARDS EARNED";
      Style: (...$MQ.@SmallBoldStyle, HorizontalAlignment: Center);
      Anchor: (Bottom: 14);
    }

    Group #RewardList {
      LayoutMode: Left;
      Anchor: (Height: 104, Bottom: 24);

      AssetImage {
        AssetPath: $MQ.@IconReward;
        Anchor: (Width: 88, Height: 88, Right: 14);
      }
    }

    TextButton #CloseButton {
      Text: "CLOSE";
      Style: $MQ.@PrimaryButtonStyle;
      Anchor: (Width: 180, Height: 44);
    }
  }
}
