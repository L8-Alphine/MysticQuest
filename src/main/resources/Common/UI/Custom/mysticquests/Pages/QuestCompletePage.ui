$Base = "../../Common.ui";
$MQ = "../Common.ui";

$Base.@PageOverlay {
  Background: #000000(0.80);
}

Group {
  LayoutMode: Center;
  Anchor: (Full: 0);

  Group {
    Anchor: (Width: 660, Height: 430);
    LayoutMode: Top;
    Background: $MQ.@Panel;
    Padding: (Horizontal: 40, Top: 36, Bottom: 30);

    Group {
      LayoutMode: Center;
      Anchor: (Bottom: 8);

      Label {
        Text: "QUEST COMPLETE";
        Style: (...$MQ.@PageTitleStyle, FontSize: 36, TextColor: $MQ.@AccentGold);
      }
    }

    Label #CompletedQuestName {
      Text: "Quest Name";
      Style: (...$MQ.@QuestTitleStyle, HorizontalAlignment: Center);
      Anchor: (Bottom: 22);
    }

    Group {
      Anchor: (Height: 1, Bottom: 22);
      Background: $MQ.@BorderGold;
    }

    Label {
      Text: "REWARDS EARNED";
      Style: (...$MQ.@SmallBoldStyle, HorizontalAlignment: Center);
      Anchor: (Bottom: 14);
    }

    Group #RewardList {
      LayoutMode: Left;
      Anchor: (Height: 104, Bottom: 24);
    }

    TextButton #CloseButton {
      Text: "CLOSE";
      Style: $MQ.@PrimaryButtonStyle;
      Anchor: (Width: 180, Height: 44);
    }
  }
}
