$C = "../Common.ui";

// MysticQuests 2.0 theme (UI / HUD Redesign Bible §4).
//
// Every MysticQuests page imports this file as $MQ. HUD documents do not: a HUD is appended while a
// player joins, and a fault anywhere in its import graph would disconnect them, so the two HUD
// documents inline the few colours they need.
//
// Paths below resolve against this file's own directory, so "Assets/v2/..." is
// Common/UI/Custom/mysticquests/Assets/v2/. The textures are generated by
// tools/build_ui_v2_textures.py; Border values are in 1x units and must match the radii there.
//
// Only styles and static values live here. A template cannot give its children caller-chosen ids,
// so anything the server writes to is declared with a literal id in the page or row document.

// ---------------------------------------------------------------- palette (§4.1)

@Void = #0A0D13;
@Frame = #0E121B;
@Raised = #161B26;
@Card = #1B2130;
@Line = #2B3344;
@Purple = #7E5DD3;
@PurpleText = #B9A2F2;
@Gold = #CCAA58;
@Cyan = #46C6C4;
@Green = #66D395;
@Red = #EF6969;
@Text = #F2F4F8;
@TextSoft = #C9CFDA;
@Muted = #9AA4B7;
@Dim = #6B7487;
@OnAccent = #14110A;

// ---------------------------------------------------------------- surfaces (§4.2)
//
// Cards use 12 px corners, restrained outlines and layered dark surfaces instead of gradients.

@FrameBackground = PatchStyle(TexturePath: "Assets/v2/SurfaceFrame.png", Border: 14);
@PanelBackground = PatchStyle(TexturePath: "Assets/v2/SurfacePanel.png", Border: 14);
@CardBackground = PatchStyle(TexturePath: "Assets/v2/SurfaceCard.png", Border: 14);
@InsetBackground = PatchStyle(TexturePath: "Assets/v2/SurfaceInset.png", Border: 14);
@SelectedCardBackground = PatchStyle(TexturePath: "Assets/v2/OutlineSelected.png", Border: 14);
@NeutralCardBackground = PatchStyle(TexturePath: "Assets/v2/OutlineNeutral.png", Border: 14);
@InputBackground = PatchStyle(TexturePath: "Assets/v2/Input.png", Border: 8);
@RuleBackground = (Color: #2B3344);

// ---------------------------------------------------------------- typography (§4.3)

@ScreenTitleStyle = LabelStyle(FontSize: 26, RenderBold: true, RenderUppercase: true, TextColor: @Text, VerticalAlignment: Center);
@QuestTitleStyle = LabelStyle(FontSize: 24, RenderBold: true, TextColor: @Text, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 16);
@ObjectiveStyle = LabelStyle(FontSize: 18, RenderBold: true, TextColor: @Text, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 13);
@BodyStyle = LabelStyle(FontSize: 15, TextColor: @TextSoft, Wrap: true);
@MetaStyle = LabelStyle(FontSize: 14, TextColor: @Muted, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 11);
@MicroGoldStyle = LabelStyle(FontSize: 12, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: @Gold);
@MicroCyanStyle = LabelStyle(FontSize: 12, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: @Cyan);
@MicroMutedStyle = LabelStyle(FontSize: 12, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: @Muted);
@HintStyle = LabelStyle(FontSize: 13, TextColor: @Muted, Wrap: true);
@ValueStyle = LabelStyle(FontSize: 14, RenderBold: true, TextColor: @Text, HorizontalAlignment: End, VerticalAlignment: Center);

// ---------------------------------------------------------------- buttons (§4.2)
//
// One accent at a time: primary is narrative purple, secondary is a quiet outlined card, and the
// destructive style is visually separate from both.

@PrimaryLabel = LabelStyle(FontSize: 15, RenderBold: true, TextColor: #FFFFFF, HorizontalAlignment: Center, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 11);
@SecondaryLabel = LabelStyle(FontSize: 15, RenderBold: true, TextColor: @Text, HorizontalAlignment: Center, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 11);
@DangerLabel = LabelStyle(FontSize: 15, RenderBold: true, TextColor: #FFD9D6, HorizontalAlignment: Center, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 11);
@DisabledLabel = LabelStyle(FontSize: 15, RenderBold: true, TextColor: @Dim, HorizontalAlignment: Center, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 11);

@PrimaryButtonStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonPrimary.png", Border: 10), LabelStyle: @PrimaryLabel),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonPrimaryHover.png", Border: 10), LabelStyle: @PrimaryLabel),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonPrimaryPressed.png", Border: 10), LabelStyle: @PrimaryLabel),
  Disabled: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonDisabled.png", Border: 10), LabelStyle: @DisabledLabel),
  Sounds: $C.@ButtonSounds
);

@SecondaryButtonStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonSecondary.png", Border: 10), LabelStyle: @SecondaryLabel),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonSecondaryHover.png", Border: 10), LabelStyle: @SecondaryLabel),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonSecondaryPressed.png", Border: 10), LabelStyle: @SecondaryLabel),
  Disabled: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonDisabled.png", Border: 10), LabelStyle: @DisabledLabel),
  Sounds: $C.@ButtonSounds
);

// A secondary button drawn as already chosen: settings options, the active tab.
@SelectedButtonStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonSelected.png", Border: 10), LabelStyle: @SecondaryLabel),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonSelected.png", Border: 10), LabelStyle: @SecondaryLabel),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonSelected.png", Border: 10), LabelStyle: @SecondaryLabel),
  Disabled: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonSelected.png", Border: 10), LabelStyle: @SecondaryLabel),
  Sounds: $C.@ButtonSounds
);

@DangerButtonStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonDanger.png", Border: 10), LabelStyle: @DangerLabel),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonDangerHover.png", Border: 10), LabelStyle: @DangerLabel),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonDangerPressed.png", Border: 10), LabelStyle: @DangerLabel),
  Disabled: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonDisabled.png", Border: 10), LabelStyle: @DisabledLabel),
  Sounds: $C.@ButtonsCancel
);

// Compact buttons for row actions in staff tools.
@SmallLabel = LabelStyle(FontSize: 13, RenderBold: true, TextColor: @Text, HorizontalAlignment: Center, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 10);
@SmallDangerLabel = LabelStyle(FontSize: 13, RenderBold: true, TextColor: #FFD9D6, HorizontalAlignment: Center, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 10);

@SmallSecondaryButtonStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonSecondary.png", Border: 10), LabelStyle: @SmallLabel),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonSecondaryHover.png", Border: 10), LabelStyle: @SmallLabel),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonSecondaryPressed.png", Border: 10), LabelStyle: @SmallLabel),
  Disabled: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonDisabled.png", Border: 10), LabelStyle: @SmallLabel),
  Sounds: $C.@ButtonSounds
);

@SmallDangerButtonStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonDanger.png", Border: 10), LabelStyle: @SmallDangerLabel),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonDangerHover.png", Border: 10), LabelStyle: @SmallDangerLabel),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonDangerPressed.png", Border: 10), LabelStyle: @SmallDangerLabel),
  Disabled: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonDisabled.png", Border: 10), LabelStyle: @SmallDangerLabel),
  Sounds: $C.@ButtonsCancel
);

@SmallPrimaryButtonStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonPrimary.png", Border: 10), LabelStyle: @SmallLabel),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonPrimaryHover.png", Border: 10), LabelStyle: @SmallLabel),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonPrimaryPressed.png", Border: 10), LabelStyle: @SmallLabel),
  Disabled: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonDisabled.png", Border: 10), LabelStyle: @SmallLabel),
  Sounds: $C.@ButtonSounds
);

// A dialogue choice: the line reads left to right like the subtitle above it, and hovering lights
// it in narrative purple so the choice about to be made is unmistakable.
@ChoiceLabel = LabelStyle(FontSize: 15, RenderBold: true, TextColor: @Text, HorizontalAlignment: Start, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 11);

@ChoiceButtonStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonSecondary.png", Border: 10), LabelStyle: @ChoiceLabel),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonPrimary.png", Border: 10), LabelStyle: @ChoiceLabel),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonPrimaryPressed.png", Border: 10), LabelStyle: @ChoiceLabel),
  Sounds: $C.@ButtonSounds
);

// ---------------------------------------------------------------- navigation rail

@NavLabel = LabelStyle(FontSize: 15, TextColor: @Muted, HorizontalAlignment: Start, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 11);
@NavHoverLabel = LabelStyle(FontSize: 15, TextColor: @Text, HorizontalAlignment: Start, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 11);
@NavSelectedLabel = LabelStyle(FontSize: 15, RenderBold: true, TextColor: @Text, HorizontalAlignment: Start, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 11);

// A rail entry that holds its own labels (a name and a count), so a Button rather than a TextButton.
@NavRowStyle = ButtonStyle(
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonGhostHover.png", Border: 10)),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonNavSelected.png", Border: 10)),
  Sounds: $C.@ButtonSounds
);

@NavRowSelectedStyle = ButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonNavSelected.png", Border: 10)),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonNavSelected.png", Border: 10)),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonNavSelected.png", Border: 10)),
  Sounds: $C.@ButtonSounds
);

@NavStyle = TextButtonStyle(
  Default: (LabelStyle: @NavLabel),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonGhostHover.png", Border: 10), LabelStyle: @NavHoverLabel),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonNavSelected.png", Border: 10), LabelStyle: @NavHoverLabel),
  Sounds: $C.@ButtonSounds
);

@NavSelectedStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonNavSelected.png", Border: 10), LabelStyle: @NavSelectedLabel),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonNavSelected.png", Border: 10), LabelStyle: @NavSelectedLabel),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/ButtonNavSelected.png", Border: 10), LabelStyle: @NavSelectedLabel),
  Sounds: $C.@ButtonSounds
);

// ---------------------------------------------------------------- selectable cards and rows
//
// A whole card that behaves as one control is a Button holding its labels. Selection is carried by
// Style, which the server may swap at runtime with Value.ref, the way the engine's own pages do.

@CardStyle = ButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineNeutral.png", Border: 14)),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/SurfaceCardHover.png", Border: 14)),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/SurfaceCardPressed.png", Border: 14)),
  Sounds: $C.@ButtonSounds
);

@CardSelectedStyle = ButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineSelected.png", Border: 14)),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineSelected.png", Border: 14)),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineSelected.png", Border: 14)),
  Sounds: $C.@ButtonSounds
);

// A card that binds no action: reads as a panel, not as a button.
@CardStaticStyle = ButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineNeutral.png", Border: 14)),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineNeutral.png", Border: 14)),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineNeutral.png", Border: 14))
);

// Quest board card frames (§7.3): the outline carries the category colour. Drawn by a Button that
// binds nothing and sits behind the card's contents, so its Style can be swapped by reference.

@BoardFramePurple = ButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/OutlinePurple.png", Border: 14)),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/OutlinePurple.png", Border: 14)),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/OutlinePurple.png", Border: 14))
);

@BoardFrameGold = ButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineGold.png", Border: 14)),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineGold.png", Border: 14)),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineGold.png", Border: 14))
);

@BoardFrameCyan = ButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineCyan.png", Border: 14)),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineCyan.png", Border: 14)),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineCyan.png", Border: 14))
);

@BoardFrameGreen = ButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineGreen.png", Border: 14)),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineGreen.png", Border: 14)),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineGreen.png", Border: 14))
);

@BoardFrameRed = ButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineRed.png", Border: 14)),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineRed.png", Border: 14)),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineRed.png", Border: 14))
);

@BoardFrameNeutral = ButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineNeutral.png", Border: 14)),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineNeutral.png", Border: 14)),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/OutlineNeutral.png", Border: 14))
);

// Filter chips above the board.

@ChipLabel = LabelStyle(FontSize: 13, RenderBold: true, TextColor: @TextSoft, HorizontalAlignment: Center, VerticalAlignment: Center);
@ChipSelectedLabel = LabelStyle(FontSize: 13, RenderBold: true, TextColor: #FFFFFF, HorizontalAlignment: Center, VerticalAlignment: Center);

@ChipStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/PillNeutral.png", Border: 11), LabelStyle: @ChipLabel),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/PillTrack.png", Border: 11), LabelStyle: @ChipSelectedLabel),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/PillPurple.png", Border: 11), LabelStyle: @ChipSelectedLabel),
  Sounds: $C.@ButtonSounds
);

@ChipSelectedStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/PillPurple.png", Border: 11), LabelStyle: @ChipSelectedLabel),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/PillPurple.png", Border: 11), LabelStyle: @ChipSelectedLabel),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/PillPurple.png", Border: 11), LabelStyle: @ChipSelectedLabel),
  Sounds: $C.@ButtonSounds
);

// ---------------------------------------------------------------- badges (§4.2, Appendix A)
//
// A badge is a TextButton that binds nothing: label and pill in one element, and its colour is a
// Style the server swaps by reference. Status is always a word too, never colour alone (§11).

@BadgeLightLabel = LabelStyle(FontSize: 12, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: #FFFFFF, HorizontalAlignment: Center, VerticalAlignment: Center);
@BadgeDarkLabel = LabelStyle(FontSize: 12, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: @OnAccent, HorizontalAlignment: Center, VerticalAlignment: Center);
@BadgeGoldTextLabel = LabelStyle(FontSize: 12, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: @Gold, HorizontalAlignment: Center, VerticalAlignment: Center);
@BadgeMutedLabel = LabelStyle(FontSize: 12, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, TextColor: @Muted, HorizontalAlignment: Center, VerticalAlignment: Center);

@BadgePurple = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/PillPurple.png", Border: 11), LabelStyle: @BadgeLightLabel),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/PillPurple.png", Border: 11), LabelStyle: @BadgeLightLabel),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/PillPurple.png", Border: 11), LabelStyle: @BadgeLightLabel)
);

@BadgeGold = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/PillGold.png", Border: 11), LabelStyle: @BadgeDarkLabel),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/PillGold.png", Border: 11), LabelStyle: @BadgeDarkLabel),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/PillGold.png", Border: 11), LabelStyle: @BadgeDarkLabel)
);

@BadgeCyan = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/PillCyan.png", Border: 11), LabelStyle: @BadgeDarkLabel),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/PillCyan.png", Border: 11), LabelStyle: @BadgeDarkLabel),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/PillCyan.png", Border: 11), LabelStyle: @BadgeDarkLabel)
);

@BadgeGreen = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/PillGreen.png", Border: 11), LabelStyle: @BadgeDarkLabel),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/PillGreen.png", Border: 11), LabelStyle: @BadgeDarkLabel),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/PillGreen.png", Border: 11), LabelStyle: @BadgeDarkLabel)
);

@BadgeRed = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/PillRed.png", Border: 11), LabelStyle: @BadgeLightLabel),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/PillRed.png", Border: 11), LabelStyle: @BadgeLightLabel),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/PillRed.png", Border: 11), LabelStyle: @BadgeLightLabel)
);

@BadgeNeutral = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/PillNeutral.png", Border: 11), LabelStyle: @BadgeMutedLabel),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/PillNeutral.png", Border: 11), LabelStyle: @BadgeMutedLabel),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/PillNeutral.png", Border: 11), LabelStyle: @BadgeMutedLabel)
);

@BadgeGoldOutline = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Assets/v2/PillOutlineGold.png", Border: 11), LabelStyle: @BadgeGoldTextLabel),
  Hovered: (Background: PatchStyle(TexturePath: "Assets/v2/PillOutlineGold.png", Border: 11), LabelStyle: @BadgeGoldTextLabel),
  Pressed: (Background: PatchStyle(TexturePath: "Assets/v2/PillOutlineGold.png", Border: 11), LabelStyle: @BadgeGoldTextLabel)
);

// ---------------------------------------------------------------- inputs

@InputStyle = InputFieldStyle(TextColor: @Text, FontSize: 15);
@InputPlaceholderStyle = InputFieldStyle(TextColor: @Dim, FontSize: 15);

// ---------------------------------------------------------------- icons
//
// Asset-root paths: only AssetImage.AssetPath reads them this way. As a Background the same string
// would be a document-relative texture path that resolves to nothing.

@IconBrand = "UI/Custom/mysticquests/Assets/Icons/brand/mysticquests_emblem.png";
@IconQuestBoard = "UI/Custom/mysticquests/Assets/Icons/navigation/quest_board.png";
@IconJournal = "UI/Custom/mysticquests/Assets/Icons/navigation/journal.png";
@IconAdmin = "UI/Custom/mysticquests/Assets/Icons/navigation/admin.png";
@IconReward = "UI/Custom/mysticquests/Assets/Icons/rewards/reward.png";
@MissingIcon = "UI/Custom/mysticquests/Assets/Icons/fallback/missing_content.png";
