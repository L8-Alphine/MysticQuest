$MQ = "../Theme.ui";

// One dialogue choice (Redesign Bible §6.5). ConversationPage appends one row per choice to
// #ChoiceList and addresses it as #ChoiceList[i] #Choice, so a node may offer any number of replies.

Group #ChoiceRow {
  LayoutMode: Left;
  Anchor: (Height: 34, Bottom: 6);

  TextButton #Choice {
    FlexWeight: 1;
    Padding: (Horizontal: 16);
    Style: $MQ.@ChoiceButtonStyle;
  }
}
