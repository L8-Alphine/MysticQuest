# Generic action fields
customUI.triggerVolumeEffectEditor.field.mysticquests:action.Action = Action Type
customUI.triggerVolumeEffectEditor.field.mysticquests:action.Action.tooltip = MysticQuests event type to execute, such as addTag, setVariable, sendTitle, hidePlayer, or an event registered by another mod.
customUI.triggerVolumeEffectEditor.field.mysticquests:action.Action.placeholder = e.g. sendTitle
customUI.triggerVolumeEffectEditor.field.mysticquests:action.Viewer = Viewer Selector
customUI.triggerVolumeEffectEditor.field.mysticquests:action.Viewer.tooltip = Optional viewer selector used by visibility actions. Leave blank to use the action's default viewer.
customUI.triggerVolumeEffectEditor.field.mysticquests:action.Viewer.placeholder = e.g. self
